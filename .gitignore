# ==========================================
# CambodiaJobs Root .gitignore
# ==========================================

# Environments & Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
env.bak/
venv.bak/

# Environment Variables & Secrets
*.env
*.env.local
*.env.*.local
!*.env.example

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
backend/**/__pycache__/
backend/apps/**/__pycache__/

# Distribution / packaging / build outputs
dist/
build/
*.egg-info/
.installed.cfg
*.egg
frontend/dist/
frontend/dist-ssr/

# Node dependencies & logs
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & SQLite
*.sqlite3
*.db
local_db.sql

# Logs
*.log
logs/
backend/logs/

# IDE & Editor files
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
